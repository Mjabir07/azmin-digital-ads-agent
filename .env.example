# Copy this file to .env and fill in the values. Never commit .env.

# Meta Marketing API
META_GRAPH_API_VERSION=v24.0   # set to the latest version shown in Meta's docs
META_APP_ID=
META_APP_SECRET=
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=act_

# Claude API
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

# Google Sheet (tabs: metrics, leads, actions_log)
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SHEET_ID=

# Owner notifications (pick one)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
REPORT_EMAIL_TO=
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=

# WhatsApp Cloud API (Phase 3)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=

# Safety
DRY_RUN=true
TIMEZONE=Asia/Dubai
